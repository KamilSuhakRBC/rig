#!/usr/bin/env python3
"""Terminal screen-buffer parser, context builder, and streaming CLI runner for 'out' and 'ask'."""

from __future__ import annotations

import argparse
import glob
import json
import os
import re
import shutil
import socket
import sqlite3
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _rig_common import ANSI_CODES, call_gemini_decisions, normalize_legacy_flags, read_config_lines, should_use_color  # noqa: E402

SELECTOR_TOKEN_RE = re.compile(r"^(?:\d+|[~@]?\d+\.\.[~@]?\d+|[~@]\d+)$")

DEFAULT_AGY_PREAMBLE = (
    "You are running in an ephemeral session via agy --print. "
    "Keep your response short and do not use markdown formatting. "
    "Minimize tool and MCP calls and prioritize fast responses while remaining accurate."
)
DEFAULT_COPILOT_PREAMBLE = (
    "Keep your response short and do not use markdown formatting. "
    "Minimize tool and MCP calls and prioritize fast responses while remaining accurate."
)


def has_pty_ring_backend() -> bool:
    return bool(os.environ.get("RIG_TEST_PTY_RING_JSON") or os.environ.get("PTY_RING_SOCK"))


def read_pty_ring_blocks() -> list[dict[str, object]]:
    """Fetch captured command blocks from $PTY_RING_SOCK or RIG_TEST_PTY_RING_JSON."""
    test_json = os.environ.get("RIG_TEST_PTY_RING_JSON")
    raw = ""
    if test_json:
        p = Path(test_json)
        if p.is_file():
            raw = p.read_text(encoding="utf-8", errors="replace")
    else:
        sock_path = os.environ.get("PTY_RING_SOCK", "").strip()
        if not sock_path or not Path(sock_path).exists():
            return []
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(2.0)
                s.connect(sock_path)
                chunks: list[bytes] = []
                while True:
                    data = s.recv(65536)
                    if not data:
                        break
                    chunks.append(data)
            raw = b"".join(chunks).decode("utf-8", errors="replace")
        except OSError:
            return []

    if not raw.strip():
        return []
    try:
        data = json.loads(raw)
    except ValueError:
        return []
    if not isinstance(data, list):
        return []
    blocks: list[dict[str, object]] = []
    for item in data:
        if isinstance(item, dict):
            cmd_str = str(item.get("command") or "")
            if cmd_str.split(None, 1)[:1] == ["out"]:
                continue
            blocks.append(
                {
                    "command": cmd_str,
                    "exit_code": item.get("exit_code"),
                    "cwd": item.get("cwd"),
                    "started_at": item.get("started_at"),
                    "duration_ms": item.get("duration_ms"),
                    "output": [str(line) for line in (item.get("output") or [])],
                }
            )
    return blocks


def resolve_block_indices(spec: str | None, count: int) -> list[int]:
    """Resolve `N`, `@N`/`~N`, or `@A..B`/`~A..B` into chronological block indices."""
    if count <= 0:
        return []
    s = (spec or "1").strip()

    m_single = re.match(r"^[~@](\d+)$", s)
    if m_single:
        offset = int(m_single.group(1))
        if offset < 1 or offset > count:
            return []
        return [count - offset]

    m_range = re.match(r"^[~@]?(\d+)\.\.[~@]?(\d+)$", s)
    if m_range:
        a = int(m_range.group(1))
        b = int(m_range.group(2))
        if a < 1 or b < 1:
            return []
        start_off = min(count, max(a, b))
        end_off = max(1, min(a, b))
        if start_off < end_off:
            return []
        return [count - off for off in range(start_off, end_off - 1, -1)]

    m_count = re.match(r"^(\d+)$", s)
    if m_count:
        n = min(count, max(1, int(m_count.group(1))))
        return list(range(count - n, count))

    raise ValueError(f"Invalid selector '{spec}'. Use N (last N), @N (Nth last), or @A..B (slice).")


def build_prompt_text(
    question_args: list[str],
    piped: str,
    include_ctx: bool,
    preamble: str,
    fallback_command: str | None = None,
) -> str | None:
    """Assemble full prompt from preamble, optional terminal context slice, piped text, and question."""
    ctx_spec = "1"
    q_list = list(question_args)
    if include_ctx and q_list and SELECTOR_TOKEN_RE.match(q_list[0].strip()):
        ctx_spec = q_list[0].strip()
        q_list = q_list[1:]

    question = " ".join(q_list).strip()
    has_piped = bool(piped.strip())
    if not question and not has_piped and not include_ctx:
        return None

    if question:
        prompt_question = question
    elif has_piped:
        prompt_question = "Analyze or answer based on the piped input above."
    else:
        prompt_question = "Explain or address the terminal command and output shown in context above."

    parts: list[str] = []
    if preamble and preamble.strip():
        parts.append(preamble.strip())

    if include_ctx:
        blocks = read_pty_ring_blocks()
        if blocks:
            indices = resolve_block_indices(ctx_spec, len(blocks))
            if indices:
                ctx_lines: list[str] = []
                for idx in indices:
                    b = blocks[idx]
                    ec = b.get("exit_code")
                    meta_parts: list[str] = []
                    if b.get("cwd"):
                        meta_parts.append(str(b["cwd"]))
                    if isinstance(ec, int) and ec != 0:
                        meta_parts.append(f"exit {ec}")
                    dur = b.get("duration_ms")
                    if isinstance(dur, int) and dur >= 1000:
                        meta_parts.append(f"{dur / 1000:.1f}s")
                    meta_note = f" ({', '.join(meta_parts)})" if meta_parts else ""
                    ctx_lines.append(f"$ {b['command']}{meta_note}")
                    out_lines: list[str] = b["output"]  # type: ignore[assignment]
                    if out_lines:
                        ctx_lines.extend(out_lines)
                    else:
                        ctx_lines.append("(no output)")
                    ctx_lines.append("")
                parts.append(f'[Context: Terminal Commands & Output ("{ctx_spec}")]\n' + "\n".join(ctx_lines).rstrip())
        else:
            hist_path = os.environ.get("RIG_SHELL_HISTORY_FILE")
            if hist_path:
                hist_lines = read_config_lines(Path(hist_path))
                if hist_lines:
                    indices = resolve_block_indices(ctx_spec, len(hist_lines))
                    sel = [f"{i + 1}: {hist_lines[i]}" for i in indices]
                    if sel:
                        parts.append("[Context: Recent Terminal Commands]\n" + "\n".join(sel))

    if has_piped:
        parts.append(f"[Context: Piped Input]\n{piped.rstrip()}")

    parts.append(f"[User Question]\n{prompt_question}")
    return "\n\n".join(parts)


def _ce(stream, text: str, color: str) -> str:
    if not should_use_color(stream):
        return text
    code = ANSI_CODES.get(color.lower(), "")
    return f"{code}{text}{ANSI_CODES['reset']}" if code else text


def remove_agy_conversation(cli_dir: Path, conv_ids: set[str]) -> None:
    """Clean up ephemeral agy conversation files and summaries DB entries."""
    if not conv_ids:
        return
    conv_dir = cli_dir / "conversations"
    brain_dir = cli_dir / "brain"
    for cid in conv_ids:
        for match in glob.glob(str(conv_dir / f"{cid}.db*")):
            try:
                Path(match).unlink(missing_ok=True)
            except OSError:
                pass
        shutil.rmtree(brain_dir / cid, ignore_errors=True)
        for sub in ("annotations", "implicit"):
            for match in glob.glob(str(cli_dir / sub / f"{cid}.*")):
                try:
                    Path(match).unlink(missing_ok=True)
                except OSError:
                    pass

    summaries_db = cli_dir / "conversation_summaries.db"
    if summaries_db.is_file():
        con: sqlite3.Connection | None = None
        try:
            con = sqlite3.connect(str(summaries_db), timeout=2.0)
            for cid in conv_ids:
                for tbl in ("conversation_summaries", "conversations_fts", "conversation_parents"):
                    try:
                        con.execute(f"DELETE FROM {tbl} WHERE conversation_id = ?", (cid,))
                    except sqlite3.Error:
                        pass
            con.commit()
        except sqlite3.Error:
            pass
        finally:
            if con is not None:
                con.close()


def stream_ask_process(
    executable: str,
    args: list[str],
    label: str,
    stream_json: bool,
    *,
    cwd: str | None = None,
    env: dict[str, str] | None = None,
) -> tuple[int, str | None]:
    """Launch ask backend CLI, show spinner until first output, and stream assistant response."""
    interactive_out = sys.stdout.isatty()
    animate = sys.stderr.isatty() and should_use_color(sys.stderr)
    exe_name = Path(executable).stem

    try:
        proc = subprocess.Popen(
            [executable, *args],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
            cwd=cwd,
            env=env,
        )
    except OSError as exc:
        print(_ce(sys.stderr, f"\n✖ {exe_name}: failed to start ({exc})\n", "red"), file=sys.stderr)
        return 1, None

    stderr_chunks: list[str] = []

    def _drain_stderr() -> None:
        assert proc.stderr is not None
        stderr_chunks.append(proc.stderr.read())

    err_thread = threading.Thread(target=_drain_stderr, daemon=True)
    err_thread.start()

    state = {
        "header_shown": False,
        "cursor_hidden": False,
        "ended_with_newline": True,
        "last_step": None,
        "saw_delta": False,
        "conv_id": None,
        "stream_error": None,
    }
    line_buf: list[str] = []
    stop_spinner = threading.Event()

    def _clear_spinner() -> None:
        if animate and state["cursor_hidden"]:
            sys.stderr.write("\r\033[2K\033[?25h")
            sys.stderr.flush()
            state["cursor_hidden"] = False

    def _show_header() -> None:
        if not state["header_shown"]:
            stop_spinner.set()
            _clear_spinner()
            sys.stderr.write(f"\n{_ce(sys.stderr, '▸ ask', 'cyan')} {_ce(sys.stderr, f'({label})', 'gray')}\n")
            sys.stderr.flush()
            state["header_shown"] = True

    def _emit_line(line: str) -> None:
        _show_header()
        sys.stdout.write(line + "\n")
        sys.stdout.flush()
        state["ended_with_newline"] = True

    def _append_delta(delta: str) -> None:
        if not delta:
            return
        if interactive_out:
            _show_header()
            norm = delta.replace("\r\n", "\n")
            sys.stdout.write(norm)
            sys.stdout.flush()
            state["ended_with_newline"] = norm.endswith("\n")
            return
        line_buf.append(delta)
        combined = "".join(line_buf)
        while "\n" in combined:
            head, combined = combined.split("\n", 1)
            _emit_line(head.rstrip("\r"))
        line_buf.clear()
        if combined:
            line_buf.append(combined)

    def _spinner_loop() -> None:
        frames = ["●∙∙∙∙", "∙●∙∙∙", "∙∙●∙∙", "∙∙∙●∙", "∙∙∙∙●"]
        idx = 0
        if animate:
            sys.stderr.write("\033[?25l")
            sys.stderr.flush()
            state["cursor_hidden"] = True
        while not stop_spinner.wait(timeout=0.14):
            if animate and not state["header_shown"]:
                sys.stderr.write(f"\r\033[36m{frames[idx % len(frames)]}\033[0m ")
                sys.stderr.flush()
                idx += 1

    spin_thread = threading.Thread(target=_spinner_loop, daemon=True)
    spin_thread.start()

    try:
        assert proc.stdout is not None
        for raw_line in proc.stdout:
            if not stream_json:
                _emit_line(raw_line.rstrip("\r\n"))
                continue

            stripped = raw_line.strip()
            if not stripped:
                continue
            try:
                ev = json.loads(stripped)
            except json.JSONDecodeError:
                continue
            if not isinstance(ev, dict):
                continue

            if ev.get("conversation_id") and not state["conv_id"]:
                state["conv_id"] = str(ev["conversation_id"])

            event_type = ev.get("event")
            if event_type == "step_update":
                su = ev.get("step_update") or {}
                stype = su.get("step_type")
                if stype == "agent_response":
                    step_idx = su.get("step_index")
                    if (
                        step_idx is not None
                        and state["last_step"] is not None
                        and step_idx != state["last_step"]
                    ):
                        if interactive_out and state["header_shown"] and not state["ended_with_newline"]:
                            sys.stdout.write("\n")
                            sys.stdout.flush()
                            state["ended_with_newline"] = True
                        elif not interactive_out and line_buf:
                            _emit_line("".join(line_buf).rstrip("\r"))
                            line_buf.clear()
                    if step_idx is not None:
                        state["last_step"] = step_idx
                    delta = su.get("text_delta")
                    if delta is not None:
                        state["saw_delta"] = True
                        _append_delta(str(delta))
                elif stype == "error_message":
                    _show_header()
                    if interactive_out and not state["ended_with_newline"]:
                        sys.stdout.write("\n")
                        sys.stdout.flush()
                        state["ended_with_newline"] = True
                    elif not interactive_out and line_buf:
                        _emit_line("".join(line_buf).rstrip("\r"))
                        line_buf.clear()
                    sys.stderr.write(_ce(sys.stderr, "[agy step interrupted — retrying]\n", "yellow"))
                    sys.stderr.flush()
            elif event_type == "result":
                res = ev.get("result") or {}
                if res.get("conversation_id") and not state["conv_id"]:
                    state["conv_id"] = str(res["conversation_id"])
                if not state["saw_delta"] and res.get("response"):
                    _append_delta(str(res["response"]))
                status = res.get("status")
                if status and status != "SUCCESS":
                    detail = res.get("error") or res.get("message")
                    if detail:
                        clean = re.sub(r"\r?\n", " ", str(detail))
                        clean = re.sub(r"\s*Retries remaining:\s*\d+\s*$", "", clean).strip()
                        state["stream_error"] = f"{status} — {clean}"
                    else:
                        state["stream_error"] = f"Status: {status}"

        if not interactive_out and line_buf:
            _emit_line("".join(line_buf).rstrip("\r"))
            line_buf.clear()
    finally:
        stop_spinner.set()
        spin_thread.join(timeout=1.0)
        _clear_spinner()
        if proc.poll() is None:
            proc.terminate()
        exit_code = proc.wait()
        err_thread.join(timeout=1.0)

    if state["header_shown"]:
        if interactive_out and not state["ended_with_newline"]:
            sys.stdout.write("\n")
            sys.stdout.flush()
        sys.stderr.write("\n")
        sys.stderr.flush()

    stderr_text = "".join(stderr_chunks).strip()
    stream_error = state["stream_error"]
    if stream_error and not stderr_text:
        print(_ce(sys.stderr, f"\n✖ {exe_name} ({label}) error: {stream_error}\n", "red"), file=sys.stderr)

    if stderr_text:
        if exit_code != 0:
            print(_ce(sys.stderr, f"\n✖ {exe_name} failed (exit {exit_code}):", "red"), file=sys.stderr)
            for err_line in stderr_text.splitlines():
                print(_ce(sys.stderr, f"  {err_line}", "red"), file=sys.stderr)
            print(file=sys.stderr)
        else:
            for err_line in stderr_text.splitlines():
                print(_ce(sys.stderr, f"  {err_line}", "darkgray"), file=sys.stderr)
            print(file=sys.stderr)
    elif exit_code != 0 and not stream_error:
        print(_ce(sys.stderr, f"\n✖ {exe_name} failed (exit {exit_code}).\n", "red"), file=sys.stderr)

    if exit_code == 0 and stream_error:
        exit_code = 1
    return exit_code, state["conv_id"]


def cmd_out(args: argparse.Namespace) -> int:
    if not has_pty_ring_backend():
        print(_ce(sys.stderr, "pty-ring is not active in this shell (PTY_RING_SOCK is unset).", "yellow"), file=sys.stderr)
        return 1
    blocks = read_pty_ring_blocks()
    if not blocks:
        print(_ce(sys.stderr, "No completed command blocks recorded in pty-ring yet.", "yellow"), file=sys.stderr)
        return 1
    try:
        indices = resolve_block_indices(args.selector, len(blocks))
    except ValueError as exc:
        print(_ce(sys.stderr, str(exc), "red"), file=sys.stderr)
        return 2
    if not indices:
        print(
            _ce(sys.stderr, f"Selector '{args.selector}' matched none of the {len(blocks)} captured block(s).", "yellow"),
            file=sys.stderr,
        )
        return 1

    for pos, idx in enumerate(indices):
        if pos > 0:
            print()
        blk = blocks[idx]
        if not args.output_only:
            print(f"$ {blk['command']}")
        for line in blk["output"]:  # type: ignore[attr-defined]
            print(line)
    return 0


def cmd_resolve_slice(args: argparse.Namespace) -> int:
    try:
        indices = resolve_block_indices(args.spec, args.count)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(indices))
    else:
        for i in indices:
            print(i)
    return 0


def cmd_build_prompt(args: argparse.Namespace) -> int:
    piped = sys.stdin.read() if not sys.stdin.isatty() else ""
    try:
        prompt = build_prompt_text(
            args.query,
            piped,
            args.ctx,
            args.preamble or DEFAULT_AGY_PREAMBLE,
            fallback_command=args.fallback_command,
        )
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if not prompt:
        print("Usage: ask [--ctx [<sel>]] <question>", file=sys.stderr)
        return 1
    print(prompt)
    return 0


def _ensure_symlink(src: Path, dst: Path) -> None:
    if not (src.exists() or src.is_symlink()):
        return
    if dst.is_symlink() and dst.resolve() != src.resolve():
        dst.unlink()
    if not dst.exists() and not dst.is_symlink():
        try:
            dst.symlink_to(src)
        except OSError:
            pass


def ensure_ask_home(ask_home: Path, real_home: Path, engine: str = "agy") -> None:
    """Create minimal isolated ask-home with dedicated ASK.md instructions and config."""
    ask_md = Path(__file__).resolve().parent.parent / "gemini" / "ASK.md"

    if engine == "copilot":
        ask_copilot = ask_home / ".copilot"
        ask_copilot.mkdir(parents=True, exist_ok=True)
        _ensure_symlink(ask_md, ask_copilot / "copilot-instructions.md")
        for cfg_name in ("config.json", "settings.json"):
            _ensure_symlink(real_home / ".copilot" / cfg_name, ask_copilot / cfg_name)
        return

    ask_gemini = ask_home / ".gemini"
    ask_gemini.mkdir(parents=True, exist_ok=True)
    _ensure_symlink(ask_md, ask_gemini / "GEMINI.md")
    _ensure_symlink(real_home / ".gemini" / "settings.json", ask_gemini / "settings.json")


def _decide_keep_or_prune(prompt_preview: str) -> str:
    """Use Gemini Decisions API to score whether an ask-home thread is worth keeping."""
    api_key = os.environ.get("GEMINI_API_KEY", "").strip()
    if not api_key or not prompt_preview.strip():
        return "prune"
    questions = {
        "verdict": {
            "type": "choice",
            "instructions": (
                "Decide whether this Q&A thread has lasting reference value ('keep') "
                "or is a trivial one-off syntax/typo/throwaway question ('prune')."
            ),
            "criteria": {"keep": "Option: keep", "prune": "Option: prune"},
        }
    }
    try:
        body = call_gemini_decisions(prompt_preview[:1000], questions, api_key=api_key, timeout=3.0)
        verdict = (body.get("answers") or {}).get("verdict") or body
        choice = str(verdict.get("choice") or verdict.get("decision") or "prune").strip().lower()
        return choice if choice in ("keep", "prune") else "prune"
    except Exception:
        return "prune"


def prune_ask_home(ask_home: Path, *, max_keep: int = 15) -> None:
    """Prune oldest ask-home conversations above max_keep using decide (fail-open to FIFO)."""
    cli_dir = ask_home / ".gemini" / "antigravity-cli"
    conv_dir = cli_dir / "conversations"
    if not conv_dir.is_dir():
        return
    dbs = sorted(conv_dir.glob("*.db"), key=lambda p: p.stat().st_mtime)
    if len(dbs) <= max_keep:
        return

    index_path = ask_home / "index.json"
    try:
        index = json.loads(index_path.read_text(encoding="utf-8")) if index_path.is_file() else {}
    except (OSError, ValueError):
        index = {}

    to_remove: set[str] = set()
    excess = len(dbs) - max_keep
    for db_path in dbs:
        if len(to_remove) >= excess:
            break
        cid = db_path.stem
        meta = index.get(cid) or {}
        if meta.get("scored") == "keep" and len(dbs) - len(to_remove) <= max_keep * 2:
            continue
        verdict = _decide_keep_or_prune(str(meta.get("preview", "")))
        if verdict == "keep" and len(dbs) - len(to_remove) <= max_keep * 2:
            meta["scored"] = "keep"
            index[cid] = meta
        else:
            to_remove.add(cid)
            index.pop(cid, None)

    if to_remove:
        remove_agy_conversation(cli_dir, to_remove)
    try:
        index_path.write_text(json.dumps(index, indent=2) + "\n", encoding="utf-8")
    except OSError:
        pass


def _load_local_workset_context(cwd: str) -> tuple[str, str] | None:
    """Load non-empty active workset context for cwd via 'workset --context-json'."""
    ws_bin = Path(__file__).resolve().parent / "workset"
    if not ws_bin.is_file():
        return None
    try:
        res = subprocess.run(
            [sys.executable, str(ws_bin), "--context-json"],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0 or not res.stdout.strip():
        return None
    try:
        data = json.loads(res.stdout)
    except ValueError:
        return None
    name = str(data.get("name") or "").strip()
    files = [str(f).strip() for f in (data.get("files") or []) if str(f).strip()]
    overview = str(data.get("overview") or "").strip()
    if not name or (not files and not overview):
        return None
    parts: list[str] = [f"[Workset Context: {name}]"]
    if files:
        parts.append("Files:\n" + "\n".join(f"- {f}" for f in files))
    if overview:
        parts.append(f"Overview & WIP:\n{overview}")
    return name, "\n\n".join(parts)


def _resolve_workspace_notes_dir(real_home: Path) -> Path:
    """Resolve the Obsidian notes directory for the active rig workspace."""
    override = os.environ.get("RIG_NOTES_DIR", "").strip()
    if override:
        return Path(override).expanduser()
    ws = os.environ.get("RIG_WORKSPACE", "personal").strip().lower()
    chain = [c.strip().lower() for c in os.environ.get("RIG_WORKSPACE_CHAIN", "").splitlines() if c.strip()]
    if ws in ("rbc", "work") or "work" in chain or "rbc" in chain:
        return real_home / "work-notes"
    return real_home / "notes"


def cmd_run(args: argparse.Namespace) -> int:
    if args.vault_cleanup and (args.local or args.reply or args.continue_interactive or args.ctx):
        print(_ce(sys.stderr, "✖ ask: cannot combine --vault-cleanup with --local, --ctx, -r/--reply, or -c/--continue.", "red"), file=sys.stderr)
        return 2
    if args.reply and args.local:
        print(_ce(sys.stderr, "✖ ask: cannot combine -r/--reply with --local; -r inherits the conversation's original directory.", "red"), file=sys.stderr)
        return 2
    if args.continue_interactive and (args.local or args.reply):
        print(_ce(sys.stderr, "✖ ask: cannot combine -c/--continue with --local or -r/--reply.", "red"), file=sys.stderr)
        return 2

    real_home = Path.home()
    use_ask_home = not (args.engine == "agy" and os.environ.get("RIG_AGY_CLI_DIR")) and not args.keep_history
    ask_home = Path(os.environ.get("RIG_ASK_HOME") or (real_home / ".local" / "share" / "ask-home")).expanduser()

    default_bin = "agy" if args.engine == "agy" else "copilot"
    exe = args.executable or os.environ.get("RIG_ASK_EXECUTABLE") or shutil.which(default_bin)
    if not exe:
        print(_ce(sys.stderr, f"✖ ask: '{default_bin}' CLI not found in PATH.", "red"), file=sys.stderr)
        return 1

    if args.vault_cleanup:
        notes_dir = _resolve_workspace_notes_dir(real_home)
        if not notes_dir.is_dir():
            print(_ce(sys.stderr, f"✖ ask: notes directory not found: {notes_dir}", "red"), file=sys.stderr)
            return 1
        model = "gemini-4-hydrogen-high" if args.high else "gemini-4-hydrogen-low"
        if args.engine == "copilot":
            code, conv_id = stream_ask_process(
                exe,
                ["--yolo", "-s", "-p", "/vault-cleanup"],
                "copilot · vault-cleanup",
                stream_json=False,
                cwd=str(notes_dir),
            )
        else:
            code, conv_id = stream_ask_process(
                exe,
                ["--dangerously-skip-permissions", "--model", model, "--output-format", "stream-json", "-p", "/vault-cleanup"],
                f"{model} · vault-cleanup",
                stream_json=True,
                cwd=str(notes_dir),
            )
        if code == 0 and (conv_id or args.engine == "copilot"):
            try:
                ask_home.mkdir(parents=True, exist_ok=True)
                (ask_home / "last.json").write_text(
                    json.dumps({"id": conv_id or "", "cwd": str(notes_dir), "real_home": True}, indent=2) + "\n",
                    encoding="utf-8",
                )
            except OSError:
                pass
        return code

    def _isolated_env() -> dict[str, str]:
        env_map = dict(os.environ)
        if args.engine == "copilot":
            env_map["COPILOT_HOME"] = str(ask_home / ".copilot")
        else:
            env_map["HOME"] = str(ask_home)
        return env_map

    if args.continue_interactive:
        ensure_ask_home(ask_home, real_home, args.engine)
        last_file = ask_home / "last.json"
        if not last_file.is_file():
            print(_ce(sys.stderr, "✖ ask: no previous 'ask' conversation found to continue.", "red"), file=sys.stderr)
            return 1
        try:
            last_meta = json.loads(last_file.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            last_meta = {}
        last_id = str(last_meta.get("id") or "").strip()
        use_real_home = bool(last_meta.get("real_home"))
        if not last_id and args.engine == "agy":
            print(_ce(sys.stderr, "✖ ask: last conversation ID is missing.", "red"), file=sys.stderr)
            return 1
        saved_cwd = str(last_meta.get("cwd") or ask_home)
        target_cwd = saved_cwd if Path(saved_cwd).is_dir() else str(ask_home)
        if args.engine == "copilot":
            cont_cmd = [exe]
            cont_cmd.extend(["--resume", last_id] if last_id else ["--continue"])
        else:
            cont_cmd = [exe, "--conversation", last_id]
        run_env = None if use_real_home else _isolated_env()
        return subprocess.run(cont_cmd, cwd=target_cwd, env=run_env, check=False).returncode

    piped = sys.stdin.read() if not sys.stdin.isatty() else ""
    if args.preamble is not None:
        preamble = args.preamble
    elif use_ask_home:
        preamble = ""
    else:
        preamble = DEFAULT_AGY_PREAMBLE if args.engine == "agy" else DEFAULT_COPILOT_PREAMBLE
    try:
        full_prompt = build_prompt_text(
            args.query,
            piped,
            args.ctx,
            preamble,
            fallback_command=args.fallback_command,
        )
    except ValueError as exc:
        print(_ce(sys.stderr, str(exc), "red"), file=sys.stderr)
        return 2

    if not full_prompt:
        print(_ce(sys.stderr, "Usage: ask [--ctx [<n>|@<n>|<a>..<b>]] [--high] [--local] [-r] [-c] [--keep-history] <question>", "yellow"), file=sys.stderr)
        return 1

    if args.local and not args.reply and not args.continue_interactive:
        ws_ctx = _load_local_workset_context(os.getcwd())
        if ws_ctx:
            ws_name, ws_text = ws_ctx
            print(_ce(sys.stderr, f"ℹ Loaded workset: {ws_name}", "cyan"), file=sys.stderr)
            full_prompt = f"{ws_text}\n\n{full_prompt}"

    model = "gemini-4-hydrogen-high" if args.high else "gemini-4-hydrogen-low"

    # Preserve legacy RIG_AGY_CLI_DIR test mode or explicit --keep-history in main ~/.gemini/antigravity-cli
    if not use_ask_home:
        if args.engine == "copilot":
            code, _ = stream_ask_process(exe, ["-s", "-p", full_prompt], "copilot", stream_json=False)
            return code
        cli_dir = Path(os.environ.get("RIG_AGY_CLI_DIR") or (real_home / ".gemini" / "antigravity-cli")).expanduser()
        conv_dir = cli_dir / "conversations"
        brain_dir = cli_dir / "brain"
        before_convs = {p.stem for p in conv_dir.glob("*.db")} if conv_dir.is_dir() else set()
        before_brain = {p.name for p in brain_dir.iterdir() if p.is_dir()} if brain_dir.is_dir() else set()
        code, conv_id = stream_ask_process(
            exe,
            ["--model", model, "--output-format", "stream-json", "-p", full_prompt],
            model,
            stream_json=True,
        )
        if not args.keep_history:
            time.sleep(0.05)
            new_ids: set[str] = set()
            if conv_id:
                new_ids.add(conv_id)
            if conv_dir.is_dir():
                new_ids.update({p.stem for p in conv_dir.glob("*.db")} - before_convs)
            if brain_dir.is_dir():
                new_ids.update({p.name for p in brain_dir.iterdir() if p.is_dir()} - before_brain)
            remove_agy_conversation(cli_dir, new_ids)
        return code

    ensure_ask_home(ask_home, real_home, args.engine)
    last_file = ask_home / "last.json"

    if args.engine == "copilot":
        cli_args = ["-s", "-p", full_prompt]
        stream_json = False
        label = "copilot"
    else:
        cli_args = ["--disable-slash-commands", "--output-format", "stream-json", "-p", full_prompt]
        if not args.reply:
            cli_args = ["--model", model, *cli_args]
        stream_json = True
        label = "resume" if args.reply else model

    run_env: dict[str, str] | None = _isolated_env()
    if args.reply:
        if not last_file.is_file():
            print(_ce(sys.stderr, "✖ ask: no previous 'ask' conversation found to resume.", "red"), file=sys.stderr)
            return 1
        try:
            last_meta = json.loads(last_file.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            last_meta = {}
        last_id = str(last_meta.get("id") or "").strip()
        use_real_home = bool(last_meta.get("real_home"))
        if not last_id and args.engine == "agy":
            print(_ce(sys.stderr, "✖ ask: last conversation ID is missing.", "red"), file=sys.stderr)
            return 1
        saved_cwd = str(last_meta.get("cwd") or ask_home)
        target_cwd = saved_cwd if Path(saved_cwd).is_dir() else str(ask_home)
        if use_real_home:
            run_env = None
        if args.engine == "copilot":
            cli_args = ["--resume", last_id, *cli_args] if last_id else ["--continue", *cli_args]
        else:
            cli_args = ["--conversation", last_id, *cli_args]
    else:
        target_cwd = os.getcwd() if args.local else str(ask_home)

    code, conv_id = stream_ask_process(
        exe,
        cli_args,
        label,
        stream_json=stream_json,
        cwd=target_cwd,
        env=run_env,
    )

    if code == 0 and (conv_id or args.engine == "copilot"):
        try:
            last_file.write_text(json.dumps({"id": conv_id or "", "cwd": target_cwd}, indent=2) + "\n", encoding="utf-8")
            if conv_id:
                index_path = ask_home / "index.json"
                index = json.loads(index_path.read_text(encoding="utf-8")) if index_path.is_file() else {}
                preview = " ".join(args.query).strip()[:200] or full_prompt[:200]
                index[conv_id] = {"cwd": target_cwd, "preview": preview, "ts": int(time.time())}
                index_path.write_text(json.dumps(index, indent=2) + "\n", encoding="utf-8")
                prune_ask_home(ask_home)
        except OSError:
            pass

    if code == 0:
        hints = ["Follow-up: ask -r '<prompt>'", "Interactive: ask -c"]
        if not args.local and not args.reply:
            hints.append("Repo context: ask --local")
        print(_ce(sys.stderr, "  ↳ " + "  ·  ".join(hints), "darkgray"), file=sys.stderr)

    return code


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="ask-helper",
        description="Terminal screen capture and streaming AI CLI helper for 'out' and 'ask'.",
    )
    sub = parser.add_subparsers(dest="subcommand", required=True)

    p_out = sub.add_parser("out", help="Print output from recent completed command block(s)")
    p_out.add_argument("selector", nargs="?", default="1", help="Block selector: N, @N, or A..B")
    p_out.add_argument("-c", "--include-command", action="store_true", help="Prepend '$ <command>' line (default)")
    p_out.add_argument("-o", "--output-only", "--no-command", dest="output_only", action="store_true", help="Omit '$ <command>' header and print output only")
    p_out.add_argument("--fallback-command", help="Fallback command name if top prompt scrolled off")
    p_out.set_defaults(func=cmd_out)

    p_slice = sub.add_parser("resolve-slice", help="Resolve block selector indices for a given count")
    p_slice.add_argument("spec", help="Selector specification")
    p_slice.add_argument("--count", type=int, required=True, help="Total block count")
    p_slice.add_argument("--json", action="store_true", help="Output JSON list")
    p_slice.set_defaults(func=cmd_resolve_slice)

    p_prompt = sub.add_parser("build-prompt", help="Assemble context-aware prompt text")
    p_prompt.add_argument("--ctx", action="store_true", help="Include captured terminal context")
    p_prompt.add_argument("--preamble", help="System/behavior preamble")
    p_prompt.add_argument("--fallback-command", help="Fallback command if top prompt scrolled off")
    p_prompt.add_argument("query", nargs="*", help="Optional leading slice spec and question")
    p_prompt.set_defaults(func=cmd_build_prompt)

    p_run = sub.add_parser("run", help="Run agy or copilot with streaming output and cleanup")
    p_run.add_argument("--engine", choices=["agy", "copilot"], required=True, help="AI CLI engine")
    p_run.add_argument("--ctx", action="store_true", help="Include recent terminal context")
    p_run.add_argument("--high", action="store_true", help="Use high-reasoning model (agy only)")
    p_run.add_argument("--local", action="store_true", help="Run in current working directory instead of global ask-home")
    p_run.add_argument("--vault-cleanup", action="store_true", help="Run '/vault-cleanup' in the active workspace's Obsidian notes directory")
    p_run.add_argument("-r", "--reply", action="store_true", help="Reply to the most recent ask conversation in its original cwd")
    p_run.add_argument("-c", "--continue", dest="continue_interactive", action="store_true", help="Open interactive agy session on the most recent ask conversation")
    p_run.add_argument("--keep-history", action="store_true", help="Retain agy conversation in main ~/.gemini/antigravity-cli")
    p_run.add_argument("--executable", help="Override CLI binary path (for testing)")
    p_run.add_argument("--preamble", help="Override prompt preamble")
    p_run.add_argument("--fallback-command", help="Fallback command if top prompt scrolled off")
    p_run.add_argument("query", nargs="*", help="Question and optional leading context selector")
    p_run.set_defaults(func=cmd_run)

    return parser


def main(argv: list[str] | None = None) -> int:
    raw = sys.argv[1:] if argv is None else argv
    parser = build_parser()
    args = parser.parse_args(normalize_legacy_flags(raw))
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
